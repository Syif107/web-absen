# ============================================================
# RelawanSync - konfigurasi server database kantor
# ------------------------------------------------------------
# Salin menjadi deploy/.env lalu isi. Jangan commit file .env.
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env
#   node deploy/scripts/generate-keys.mjs --write
# ============================================================

# --- Database -------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Pakai huruf/angka saja agar aman dipakai di URL koneksi.
POSTGRES_PASSWORD=GANTI_DENGAN_PASSWORD_PANJANG_ACAK

# Samakan major version dengan database Supabase sumber
# (cek: select version(); di SQL Editor Supabase).
POSTGRES_IMAGE=supabase/postgres:17.6.1.136

# --- Auth (GoTrue) --------------------------------------------
AUTH_IMAGE=supabase/gotrue:v2.197.0
REST_IMAGE=postgrest/postgrest:v14.18
CADDY_IMAGE=caddy:2-alpine

# Minimal 32 karakter. generate-keys.mjs --write mengisinya otomatis.
JWT_SECRET=GANTI_DENGAN_SECRET_MINIMAL_32_KARAKTER

# Diisi otomatis oleh generate-keys.mjs --write.
ANON_KEY=
SERVICE_ROLE_KEY=

JWT_EXPIRY=3600
DISABLE_SIGNUP=true

# URL HTTPS Tailscale PC server, TANPA garis miring di akhir.
# Contoh: https://relawansync.tailxxxx.ts.net
API_EXTERNAL_URL=https://GANTI_NAMA_PC.tailxxxx.ts.net

# URL lengkap web absen di GitHub Pages (boleh berisi path repo).
# Contoh: https://nama-akun.github.io/web-absen
SITE_URL=https://GANTI_AKUN.github.io/web-absen
ADDITIONAL_REDIRECT_URLS=

# --- Gateway / CORS -------------------------------------------
# HARUS origin saja: tanpa path, tanpa garis miring di akhir.
# Contoh: https://nama-akun.github.io
# Boleh "*" untuk uji awal, tetapi isi origin persis untuk produksi.
CORS_ORIGIN=*
GATEWAY_PORT=8080

# --- PostgREST -------------------------------------------------
PGRST_DB_SCHEMAS=public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions

# --- Lain-lain -------------------------------------------------
TZ=Asia/Jakarta
